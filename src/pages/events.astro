---
import PageLayout from "@/layouts/PageLayout.astro"
import PageHeader from "@/components/PageHeader.astro"
import IconCalendar from "@/components/icons/IconCalendar.astro"
import EventCard from "@/components/events/EventCard.astro"
import ApiDownBanner from "@/components/ApiDownBanner.astro"
import Pagination from "@/components/Pagination.astro"
import { fetchEventsPaginated, EVENT_CATEGORIES, type EventCategory } from "@/utils/api/events"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)
const dateLocale = t.mensa.dateLocale

const PAGE_SIZE = 15

const rawCategory = Astro.url.searchParams.get("category")
const activeCategory = (EVENT_CATEGORIES as readonly string[]).includes(rawCategory ?? "")
  ? (rawCategory as EventCategory)
  : undefined

const rawDate = Astro.url.searchParams.get("date")
const dateFilter = rawDate === "week" || rawDate === "month" ? rawDate : "upcoming"

const rawPage = parseInt(Astro.url.searchParams.get("page") ?? "1", 10)
const currentPage = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage

const hasActiveFilter = activeCategory !== undefined || dateFilter !== "upcoming"

const { data, apiDown } = await fetchEventsPaginated({
  category: activeCategory,
  dateFilter,
  page: currentPage,
  pageSize: PAGE_SIZE,
})
const { events, total, page: actualPage, pageCount } = data

if (!apiDown && events.length === 0 && total > 0) {
  const redirectParams = new URLSearchParams(Astro.url.searchParams)
  redirectParams.delete("page")
  const qs = redirectParams.toString()
  return Astro.redirect(qs ? `?${qs}` : Astro.url.pathname)
}

const isLoggedIn = !!Astro.locals.user
const clearUrl = Astro.url.pathname

function categoryUrl(cat?: string) {
  const params = new URLSearchParams(Astro.url.searchParams)
  params.delete("page")
  if (!cat || cat === "all") params.delete("category")
  else params.set("category", cat)
  const qs = params.toString()
  return qs ? `?${qs}` : Astro.url.pathname
}

const grouped = Map.groupBy(events, (e) =>
  new Date(e.start).toLocaleDateString(dateLocale, {
    weekday: "long",
    day: "numeric",
    month: "long",
  })
)

const dateFilters = [
  { key: "upcoming", label: t.events.filterDateUpcoming },
  { key: "week", label: t.events.filterDateWeek },
  { key: "month", label: t.events.filterDateMonth },
] as const
---

<PageLayout description={t.events.pageSubtitle} title={t.events.pageTitle}>
  <PageHeader color="primary" subtitle={t.events.pageSubtitle} title={t.events.pageTitle}>
    <IconCalendar class="h-5 w-5" slot="icon" />
    <div class="flex items-center gap-2" slot="action">
      {
        isLoggedIn && (
          <a class="btn btn-outline btn-sm" href="/account/events">
            {t.auth.myEvents}
          </a>
        )
      }
      <a class="btn btn-primary btn-sm" href="/event/new">{t.events.submitEvent}</a>
    </div>
  </PageHeader>

  {apiDown && <ApiDownBanner />}

  <div class="mb-2 flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-sm text-base-content/40">{t.events.filterCategory}:</span>
      <a
        aria-current={activeCategory === undefined ? "true" : undefined}
        class:list={[
          "btn btn-sm",
          {
            "btn-primary": activeCategory === undefined,
            "btn-outline": activeCategory !== undefined,
          },
        ]}
        href={categoryUrl("all")}
      >
        {t.events.filterAll}
      </a>
      {
        EVENT_CATEGORIES.map((cat) => (
          <a
            aria-current={activeCategory === cat ? "true" : undefined}
            class:list={[
              "btn btn-sm",
              { "btn-primary": activeCategory === cat, "btn-outline": activeCategory !== cat },
            ]}
            href={categoryUrl(cat)}
          >
            {t.events.categories[cat]}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <label class="text-sm text-base-content/40" for="event-date-filter">
        {t.events.filterDate}:
      </label>
      <select class="select select-bordered select-xs" id="event-date-filter">
        {
          dateFilters.map(({ key, label }) => (
            <option selected={key === dateFilter} value={key}>
              {label}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <p aria-live="polite" class="mb-4 text-sm text-base-content/40">
    {total}
    {total === 1 ? t.events.resultSingular : t.events.resultPlural}
  </p>

  {
    !apiDown &&
      (events.length === 0 ? (
        <div class="rounded-xl border border-base-300 py-16 text-center">
          <IconCalendar class="mx-auto mb-4 h-10 w-10 text-base-content/40" />
          <p class="mb-4 text-base-content/70">
            {hasActiveFilter ? t.events.noEventsFiltered : t.events.noEvents}
          </p>
          {hasActiveFilter && (
            <a class="btn btn-outline btn-sm" href={clearUrl}>
              {t.events.clearFilters}
            </a>
          )}
        </div>
      ) : (
        <div class="space-y-10">
          {[...grouped.entries()].map(([day, dayEvents]) => (
            <div>
              <h2 class="mb-4 text-lg font-semibold capitalize">{day}</h2>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {dayEvents.map((event) => (
                  <EventCard event={event} />
                ))}
              </div>
            </div>
          ))}
        </div>
      ))
  }

  <Pagination
    nextLabel={t.jobs.paginationNext}
    page={actualPage}
    pageCount={pageCount}
    prevLabel={t.jobs.paginationPrev}
  />
</PageLayout>

<script>
  const dateSelect = document.getElementById("event-date-filter") as HTMLSelectElement | null
  if (dateSelect) {
    dateSelect.addEventListener("change", () => {
      const params = new URLSearchParams(window.location.search)
      if (dateSelect.value === "upcoming") params.delete("date")
      else params.set("date", dateSelect.value)
      params.delete("page")
      const qs = params.toString()
      window.location.href = qs ? `?${qs}` : window.location.pathname
    })
  }
</script>
