---
import { actions, isInputError } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchLocationForAdmin } from "@/utils/api/locations"
import { canManageLocations, requireRole } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import LocationForm from "@/components/locations/LocationForm.astro"

const t = useTranslations(Astro.locals.locale)

const guard = await requireRole(
  Astro,
  canManageLocations,
  `/admin/locations/${Astro.params.slug}/edit`
)
if (guard instanceof Response) return guard

const { slug } = Astro.params
const { data: location } = slug ? await fetchLocationForAdmin(slug) : { data: null }
if (!location) return Astro.redirect("/admin/locations")

const result = Astro.getActionResult(actions.locations.update)
if (result?.data) return Astro.redirect("/admin/locations")

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const generalError = result?.error && !isInputError(result.error) ? result.error.message : null
---

<PageLayout title={t.locations.editTitle}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/admin/locations">
      <IconArrowLeft class="h-4 w-4" />
      {t.admin.locationsTitle}
    </a>
  </div>

  <section class="mb-8">
    <h1 class="mb-1 text-3xl font-bold tracking-tight sm:text-4xl">{t.locations.editTitle}</h1>
  </section>

  {
    generalError && (
      <div class="alert alert-error mb-6" role="alert">
        <span>{generalError}</span>
      </div>
    )
  }

  <LocationForm
    action={actions.locations.update}
    cancelHref="/admin/locations"
    id={location.id}
    initialValues={{
      name: location.name,
      description: location.description ?? "",
      category: location.category,
      lat: location.lat,
      lon: location.lon,
      external_url: location.external_url ?? "",
      address_street: location.address?.street ?? "",
      address_street_number: location.address?.streetNumber ?? "",
      address_city: location.address?.city ?? "",
      address_zip: location.address?.zip ?? "",
    }}
    inputErrors={inputErrors}
    submitLabel={t.locations.updateLocation}
  />
</PageLayout>
