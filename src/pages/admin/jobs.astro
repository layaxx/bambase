---
import { actions } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchSubmittedJobOffers, fetchRecentlyModeratedJobOffers } from "@/utils/api/job-offers"
import { canModerateJobOffers, requireRole } from "@/utils/authz"
import { JOB_STATUS_BADGE_CLASS } from "@/utils/job-status"
import { useTranslations } from "@/i18n/translations"
import { formatLongDate } from "@/utils/event-formatting"

const t = useTranslations(Astro.locals.locale)

const guard = await requireRole(Astro, canModerateJobOffers, "/admin/jobs")
if (guard instanceof Response) return guard

const approveResult = Astro.getActionResult(actions.jobs.approve)
const rejectResult = Astro.getActionResult(actions.jobs.reject)
if (
  (approveResult?.data !== undefined && !approveResult.error) ||
  (rejectResult?.data !== undefined && !rejectResult.error)
) {
  return Astro.redirect(Astro.url.pathname)
}

const { data: jobs } = await fetchSubmittedJobOffers()
const { data: recentlyModerated } = await fetchRecentlyModeratedJobOffers()

const statusLabel: Record<string, string> = {
  published: t.auth.statusPublished,
  rejected: t.auth.statusRejected,
}
---

<PageLayout title={t.admin.jobsQueueTitle}>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.admin.jobsQueueTitle}</h1>
    {jobs.length > 0 && (
      <span class="badge badge-error whitespace-nowrap" data-testid="job-queue-count">
        {t.admin.pendingCount(jobs.length)}
      </span>
    )}
  </div>

  {jobs.length === 0 ? (
    <p
      class="rounded-xl border border-base-300 bg-base-100 p-6 text-base-content/70"
      data-testid="job-queue"
    >
      {t.admin.noSubmittedJobs}
    </p>
  ) : (
    <>
      <form
        action={actions.jobs.reject}
        class="mb-3 flex flex-wrap items-center gap-2 rounded-xl bg-base-200 px-4 py-3"
        id="bulk-moderation"
        method="POST"
      >
        <label class="mr-2 flex cursor-pointer items-center gap-3 text-sm font-medium">
          <input class="checkbox checkbox-sm" id="select-all-jobs" type="checkbox" />
          {t.admin.selectAll}
        </label>
        <span class="text-sm font-medium text-base-content/70">{t.admin.bulkActionsLabel}</span>
        <button
          class="btn btn-success btn-sm"
          formaction={actions.jobs.approve}
          formnovalidate
          type="submit"
        >
          {t.admin.approveJob}
        </button>
        <div class="flex min-w-64 flex-1 gap-2">
          <input
            aria-label={t.admin.rejectReasonPlaceholder}
            class="input input-sm input-bordered min-w-0 flex-1"
            maxlength="500"
            name="reason"
            placeholder={t.admin.rejectReasonPlaceholder}
            required
            type="text"
          />
          <button class="btn btn-outline btn-error btn-sm" type="submit">
            {t.admin.rejectJob}
          </button>
        </div>
      </form>
      <div class="flex flex-col gap-3" data-testid="job-queue">
        {jobs.map((job) => (
          <div class="flex gap-3 rounded-xl border border-base-300 bg-base-100 p-4">
            <input
              aria-label={t.admin.selectJob(job.title)}
              class="checkbox checkbox-sm mt-0.5"
              form="bulk-moderation"
              name="id"
              type="checkbox"
              value={job.id}
            />
            <div class="flex min-w-0 flex-1 flex-col gap-3">
              <div>
                <h2 class="font-semibold leading-snug text-base-content">
                  <a class="link-hover" href={`/job/${job.slug}`}>
                    {job.title}
                  </a>
                </h2>
                <p class="text-sm text-base-content/70">
                  {job.company} · {job.location} ·{" "}
                  {t.admin.submittedOn(formatLongDate(job.createdAt, t.auth.dateLocale))}
                </p>
                <p class="mt-1 line-clamp-2 text-sm text-base-content/70">{job.description}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <form action={actions.jobs.approve} method="POST">
                  <input name="id" type="hidden" value={job.id} />
                  <button class="btn btn-success btn-sm" type="submit">
                    {t.admin.approveJob}
                  </button>
                </form>
                <form action={actions.jobs.reject} class="flex min-w-64 flex-1 gap-2" method="POST">
                  <input name="id" type="hidden" value={job.id} />
                  <input
                    aria-label={t.admin.rejectReasonPlaceholder}
                    class="input input-sm input-bordered min-w-0 flex-1"
                    maxlength="500"
                    name="reason"
                    placeholder={t.admin.rejectReasonPlaceholder}
                    required
                    type="text"
                  />
                  <button class="btn btn-outline btn-error btn-sm" type="submit">
                    {t.admin.rejectJob}
                  </button>
                </form>
                <a class="btn btn-ghost btn-sm" href={`/admin/jobs/${job.slug}/edit`}>
                  {t.admin.editJob}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </>
  )}

  <h2 class="text-2xl font-bold tracking-tight mt-12 mb-6">{t.admin.recentDecisionsTitle}</h2>

  {recentlyModerated.length === 0 ? (
    <p
      class="rounded-xl border border-base-300 bg-base-100 p-6 text-base-content/70"
      data-testid="recent-decisions"
    >
      {t.admin.noRecentDecisions}
    </p>
  ) : (
    <div class="flex flex-col gap-3" data-testid="recent-decisions">
      {recentlyModerated.map((job) => (
        <div class="flex flex-col gap-3 rounded-xl border border-base-300 bg-base-100 p-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-semibold leading-snug text-base-content">{job.title}</h3>
              <span
                class:list={[
                  "badge badge-sm",
                  JOB_STATUS_BADGE_CLASS[job.online_status] ?? "badge-neutral",
                ]}
              >
                {statusLabel[job.online_status] ?? job.online_status}
              </span>
            </div>
            <p class="text-sm text-base-content/70">
              {job.company} · {job.location}
            </p>
            {job.online_status === "rejected" && job.rejection_reason && (
              <p class="text-sm text-base-content/70">
                {t.jobs.rejectionReasonLabel(job.rejection_reason)}
              </p>
            )}
            <p class="text-xs text-base-content/40">
              {t.admin.decidedAt(formatLongDate(job.updatedAt, t.auth.dateLocale))}
            </p>
          </div>
          <a class="btn btn-outline btn-sm" href={`/admin/jobs/${job.slug}/edit`}>
            {t.admin.editJob}
          </a>
        </div>
      ))}
    </div>
  )}
</PageLayout>

<script>
  const all = document.querySelector<HTMLInputElement>("#select-all-jobs")
  const boxes = [
    ...document.querySelectorAll<HTMLInputElement>('input[form="bulk-moderation"][name="id"]'),
  ]

  all?.addEventListener("change", () => {
    for (const box of boxes) box.checked = all.checked
  })

  for (const box of boxes) {
    box.addEventListener("change", () => {
      if (!all) return
      const checked = boxes.filter((b) => b.checked).length
      all.checked = checked === boxes.length
      all.indeterminate = checked > 0 && checked < boxes.length
    })
  }
</script>
