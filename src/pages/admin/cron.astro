---
import { actions } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchCronJobStatuses, type CronJobStatus } from "@/utils/api/cron-jobs"
import { canViewSystemStatus, requireRole } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import ApiDownBanner from "@/components/ApiDownBanner.astro"
import Alert from "@/components/Alert.astro"

const t = useTranslations(Astro.locals.locale)

const guard = await requireRole(Astro, canViewSystemStatus, "/admin/cron")
if (guard instanceof Response) return guard

const runResult = Astro.getActionResult(actions.cron.run)
if (runResult?.data !== undefined && !runResult.error) {
  return Astro.redirect(Astro.url.pathname)
}
const runError = runResult?.error ? runResult.error.message : null

const { data: jobs, apiDown } = await fetchCronJobStatuses()

function statusLabel(job: CronJobStatus) {
  if (!job.lastRun) return t.admin.cronStatusNeverRun
  return job.lastRun.status === "success" ? t.admin.cronStatusSuccess : t.admin.cronStatusError
}

function statusBadgeClass(job: CronJobStatus) {
  if (!job.lastRun) return "badge-neutral"
  return job.lastRun.status === "success" ? "badge-success" : "badge-error"
}
---

<PageLayout title={t.admin.cronTitle}>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">{t.admin.cronTitle}</h1>

  {runError && <Alert variant="error">{runError}</Alert>}

  {apiDown ? (
    <ApiDownBanner />
  ) : (
    <div class="flex flex-col gap-3">
      {jobs.map((job) => (
        <div class="flex flex-col gap-3 rounded-xl border border-base-300 bg-base-100 p-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="font-semibold leading-snug text-base-content">
              {t.admin.cronJobLabels[job.key]}
            </p>
            <p class="text-sm text-base-content/70">{t.admin.cronScheduleLabel(job.schedule)}</p>
            {job.lastRun ? (
              <p class="mt-1 text-xs text-base-content/70">
                {t.admin.cronLastRunAt(
                  new Date(job.lastRun.startedAt).toLocaleString(t.auth.dateLocale)
                )}
                {" · "}
                {t.admin.cronDuration((job.lastRun.durationMs / 1000).toFixed(1))}
              </p>
            ) : (
              <p class="mt-1 text-xs text-base-content/70">{t.admin.cronNeverRun}</p>
            )}
            {job.lastRun?.status === "error" && job.lastRun.error && (
              <p class="mt-1 text-xs text-error break-all">{job.lastRun.error}</p>
            )}
          </div>
          <div class="flex items-center gap-2">
            <span class:list={["badge badge-sm", statusBadgeClass(job)]}>{statusLabel(job)}</span>
            <form action={actions.cron.run} method="POST">
              <input name="key" type="hidden" value={job.key} />
              <button class="btn btn-outline btn-sm" type="submit">
                {t.admin.cronRunNow}
              </button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}
</PageLayout>
