---
import { actions } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchAllStudentGroupsForAdmin } from "@/utils/api/student-groups"
import { canManageStudentGroups, requireRole } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import ConfirmModal from "@/components/ConfirmModal.astro"

const t = useTranslations(Astro.locals.locale)

const guard = await requireRole(Astro, canManageStudentGroups, "/admin/student-groups")
if (guard instanceof Response) return guard

const deleteResult = Astro.getActionResult(actions.studentGroups.delete)
if (deleteResult?.data !== undefined && !deleteResult.error) {
  return Astro.redirect(Astro.url.pathname)
}

const { data: groups } = await fetchAllStudentGroupsForAdmin()
---

<PageLayout title={t.admin.studentGroupsTitle}>
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.admin.studentGroupsTitle}</h1>
    <a class="btn btn-primary btn-sm" href="/admin/student-groups/new">
      {t.admin.newStudentGroup}
    </a>
  </div>

  {
    groups.length === 0 ? (
      <p class="rounded-xl border border-base-300 bg-base-100 p-6 text-base-content/70">
        {t.admin.noStudentGroups}
      </p>
    ) : (
      <div class="flex flex-col gap-3">
        {groups.map((group) => (
          <div class="flex flex-col gap-3 rounded-xl border border-base-300 bg-base-100 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="font-semibold leading-snug text-base-content">{group.name}</h2>
              <p class="line-clamp-2 text-sm text-base-content/70">{group.description}</p>
            </div>
            <div class="flex gap-2">
              <a class="btn btn-outline btn-sm" href={`/admin/student-groups/${group.slug}/edit`}>
                {t.admin.editStudentGroup}
              </a>
              <button
                class="btn btn-outline btn-error btn-sm"
                onclick={`document.getElementById('deleteStudentGroupModal-${group.id}').showModal()`}
                type="button"
              >
                {t.studentGroups.deleteStudentGroup}
              </button>
              <ConfirmModal
                confirmClass="btn btn-error"
                confirmLabel={t.studentGroups.deleteStudentGroup}
                formAction={actions.studentGroups.delete}
                hiddenInputs={[{ name: "id", value: group.id }]}
                id={`deleteStudentGroupModal-${group.id}`}
                message={t.studentGroups.deleteConfirm}
              />
            </div>
          </div>
        ))}
      </div>
    )
  }
</PageLayout>
