---
import { actions, isInputError } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchJobOffer } from "@/utils/api/job-offers"
import { canModerateJobOffers, requireRole } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import JobForm from "@/components/jobs/JobForm.astro"

const t = useTranslations(Astro.locals.locale)

const guard = await requireRole(
  Astro,
  canModerateJobOffers,
  `/admin/jobs/${Astro.params.slug}/edit`
)
if (guard instanceof Response) return guard
const { user } = guard

const { slug } = Astro.params
const { data: job } = slug
  ? await fetchJobOffer(slug, { userId: user.id, isModerator: true })
  : { data: null }
if (!job) return Astro.redirect("/admin/jobs")

const result = Astro.getActionResult(actions.jobs.update)
if (result?.data) return Astro.redirect("/admin/jobs")

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const generalError = result?.error && !isInputError(result.error) ? result.error.message : null
---

<PageLayout title={t.jobs.editTitle}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/admin/jobs">
      <IconArrowLeft class="h-4 w-4" />
      {t.admin.jobsQueueTitle}
    </a>
  </div>

  <section class="mb-8">
    <h1 class="mb-1 text-3xl font-bold tracking-tight sm:text-4xl">{t.jobs.editTitle}</h1>
  </section>

  {
    generalError && (
      <div class="alert alert-error mb-6" role="alert">
        <span>{generalError}</span>
      </div>
    )
  }

  <JobForm
    action={actions.jobs.update}
    cancelHref="/admin/jobs"
    id={job.id}
    initialValues={{
      title: job.title,
      company: job.company,
      location: job.location,
      working_hours: job.working_hours,
      description: job.description,
      job_type: job.job_type,
      field: job.field,
      work_mode: job.work_mode,
      external_url: job.external_url ?? "",
      contact_name: job.contact?.name ?? "",
      contact_mail: job.contact?.mail ?? "",
      contact_phone: job.contact?.phone ?? "",
    }}
    inputErrors={inputErrors}
    submitLabel={t.jobs.updateJob}
  />
</PageLayout>
