---
import { actions, isInputError } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchEventForAdmin } from "@/utils/api/events"
import { fetchLocations } from "@/utils/api/locations"
import { canModerateEvents, requireRole } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import EventForm from "@/components/events/EventForm.astro"
import { eventFormValues } from "@/utils/event-formatting"

const t = useTranslations(Astro.locals.locale)

const guard = await requireRole(Astro, canModerateEvents, `/admin/events/${Astro.params.slug}/edit`)
if (guard instanceof Response) return guard

const { slug } = Astro.params
const [{ data: event }, { data: allLocations }] = await Promise.all([
  slug ? fetchEventForAdmin(slug) : Promise.resolve({ data: null }),
  fetchLocations(),
])

if (!event) return Astro.redirect("/admin/events")

const result = Astro.getActionResult(actions.events.update)
if (result?.data) return Astro.redirect("/admin/events")

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const generalError = result?.error && !isInputError(result.error) ? result.error.message : null
---

<PageLayout title={t.events.editTitle}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/admin/events">
      <IconArrowLeft class="h-4 w-4" />
      {t.admin.eventsTitle}
    </a>
  </div>

  <section class="mb-8">
    <h1 class="mb-1 text-3xl font-bold tracking-tight sm:text-4xl">{t.events.editTitle}</h1>
  </section>

  {generalError && (
    <div class="alert alert-error mb-6" role="alert">
      <span>{generalError}</span>
    </div>
  )}

  <EventForm
    action={actions.events.update}
    allLocations={allLocations}
    cancelHref="/admin/events"
    id={event.id}
    initialValues={eventFormValues(event)}
    inputErrors={inputErrors}
    submitLabel={t.events.updateEvent}
  />
</PageLayout>
