---
import { actions } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchJobOffer } from "@/utils/api/job-offers"
import { canModerateJobOffers } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import Alert from "@/components/Alert.astro"
import IconPencil from "@/components/icons/IconPencil.astro"
import IconArchive from "@/components/icons/IconArchive.astro"
import IconTrash from "@/components/icons/IconTrash.astro"
import ConfirmModal from "@/components/ConfirmModal.astro"
import { canArchiveJob, canEditJob } from "@/utils/job-status"
import JobStatusAlert from "@/components/jobs/JobStatusAlert.astro"
import JobDetails from "@/components/jobs/JobDetails.astro"

const t = useTranslations(Astro.locals.locale)

const me = Astro.locals.user
const isModerator = me ? await canModerateJobOffers(me.role) : false
const { slug } = Astro.params
const job = slug ? await fetchJobOffer(slug, { userId: me?.id, isModerator }) : null
if (!job) Astro.response.status = 404
const isOwner = !!(me && job?.ownerId === me.id)
const canArchive = !!job && canArchiveJob(job.online_status)

const reportResult = Astro.getActionResult(actions.reports.submit)
if (reportResult) {
  return Astro.redirect(
    `${Astro.url.pathname}?reported=${reportResult.error ? "error" : "success"}`
  )
}

const deleteResult = Astro.getActionResult(actions.jobs.delete)
if (deleteResult?.data !== undefined && !deleteResult.error) {
  return Astro.redirect("/account/jobs")
}

const archiveResult = Astro.getActionResult(actions.jobs.archive)
if (archiveResult?.data !== undefined && !archiveResult.error) {
  return Astro.redirect(Astro.url.pathname)
}

const actionError = archiveResult?.error ?? deleteResult?.error
const reported = Astro.url.searchParams.get("reported")
const justSubmitted = isOwner && Astro.url.searchParams.has("submitted")

const description = job
  ? `${job.company}${job.description ? ` – ${job.description.slice(0, 120)}` : ""}`
  : undefined
const ogImage =
  job?.online_status === "published" ? `${Astro.url.origin}/api/og/job/${job.slug}.png` : undefined
---

<PageLayout description={description} ogImage={ogImage} title={job?.title ?? t.jobs.pageTitle}>
  {!job ? (
    <div class="text-center py-20">
      <h1 class="text-3xl font-bold mb-4">{t.jobs.notFound.headline}</h1>
      <p class="text-base-content/70">{t.jobs.notFound.description}</p>
      <div class="mt-6">
        <a class="btn btn-primary" href="/jobs">
          {t.jobs.backToJobs}
        </a>
      </div>
    </div>
  ) : (
    <>
      <div class="mb-4 md:mb-6 flex flex-wrap items-center justify-between gap-1 md:gap-4">
        <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/jobs">
          <IconArrowLeft class="h-4 w-4" />
          {t.jobs.backToJobs}
        </a>
        {(isModerator || isOwner) && (
          <div class="flex flex-wrap items-center gap-2 max-sm:w-full">
            {isModerator && (
              <a class="btn btn-outline btn-sm" href={`/admin/jobs/${job.slug}`}>
                {t.admin.moderateJob}
              </a>
            )}
            {isOwner && (
              <div class="flex items-center gap-2 max-sm:w-full">
                <a class="btn btn-ghost btn-sm max-sm:mr-auto max-sm:pl-0" href="/account/jobs">
                  {t.auth.myJobOffers}
                </a>
                {canEditJob(job.online_status) && (
                  <a
                    class="btn btn-outline btn-sm relative max-sm:btn-square"
                    href={`/job/${job.slug}/edit`}
                  >
                    <IconPencil class="h-4 w-4 sm:hidden" />
                    <span class="sr-only sm:not-sr-only">{t.jobs.editJob}</span>
                  </a>
                )}
                {canArchive && (
                  <button
                    class="btn btn-outline btn-sm relative max-sm:btn-square"
                    onclick="document.getElementById('archiveJobModal').showModal()"
                    type="button"
                  >
                    <IconArchive class="h-4 w-4 sm:hidden" />
                    <span class="sr-only sm:not-sr-only">{t.jobs.archiveJob}</span>
                  </button>
                )}
                <button
                  class="btn btn-outline btn-error btn-sm relative max-sm:btn-square"
                  onclick="document.getElementById('deleteJobModal').showModal()"
                  type="button"
                >
                  <IconTrash class="h-4 w-4 sm:hidden" />
                  <span class="sr-only sm:not-sr-only">{t.jobs.deleteJob}</span>
                </button>
              </div>
            )}
          </div>
        )}
      </div>

      {justSubmitted && <Alert variant="success">{t.jobs.submitSuccess}</Alert>}
      {actionError && <Alert variant="error">{actionError.message}</Alert>}
      <JobStatusAlert isOwner={isOwner} job={job} />
      {reported === "success" && <Alert variant="success">{t.reports.successMessage}</Alert>}
      {reported === "error" && <Alert variant="error">{t.reports.errorMessage}</Alert>}

      <JobDetails job={job} showReport={!isOwner && !reported} />

      {isOwner && canArchive && (
        <ConfirmModal
          confirmClass="btn btn-warning"
          confirmLabel={t.jobs.archiveJob}
          formAction={actions.jobs.archive}
          hiddenInputs={[{ name: "id", value: job.id }]}
          id="archiveJobModal"
          message={t.jobs.archiveConfirm}
        />
      )}
      {isOwner && (
        <ConfirmModal
          confirmClass="btn btn-error"
          confirmLabel={t.jobs.deleteJob}
          formAction={actions.jobs.delete}
          hiddenInputs={[{ name: "id", value: job.id }]}
          id="deleteJobModal"
          message={t.jobs.deleteConfirm}
        />
      )}
    </>
  )}
</PageLayout>
