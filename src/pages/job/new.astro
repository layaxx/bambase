---
import { actions, isInputError } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { useTranslations } from "@/i18n/translations"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import JobForm from "@/components/jobs/JobForm.astro"

const t = useTranslations(Astro.locals.locale)

if (!Astro.locals.user) {
  return Astro.redirect(`/login?redirect=/job/new`)
}

const emailVerified = Astro.locals.user.emailVerified

const result = Astro.getActionResult(actions.jobs.create)

if (result?.data) {
  return Astro.redirect(`/job/${result.data.slug}`)
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const generalError = result?.error && !isInputError(result.error) ? result.error.message : null
---

<PageLayout title={t.jobs.createTitle}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/jobs">
      <IconArrowLeft class="h-4 w-4" />
      {t.jobs.backToJobs}
    </a>
  </div>

  <section class="mb-8">
    <h1 class="mb-1 text-3xl font-bold tracking-tight sm:text-4xl">{t.jobs.createTitle}</h1>
    <p class="text-base-content/70">{t.jobs.createSubtitle}</p>
  </section>

  {generalError && (
    <div class="alert alert-error mb-6" role="alert">
      <span>{generalError}</span>
    </div>
  )}

  {!emailVerified && (
    <div
      class="alert alert-warning mb-6 flex-col items-start sm:flex-row sm:items-center"
      role="alert"
    >
      <div>
        <h3 class="font-bold">{t.auth.verifyEmailRequiredTitle}</h3>
        <p>{t.auth.verifyEmailRequiredText}</p>
      </div>
      <button
        class="btn btn-sm mt-2 sm:mt-0"
        data-email={Astro.locals.user.email}
        data-sent-label={t.auth.resendVerificationSent}
        id="resend-verification-btn"
        type="button"
      >
        {t.auth.resendVerificationBtn}
      </button>
    </div>
  )}

  {emailVerified && (
    <JobForm
      action={actions.jobs.create}
      cancelHref="/jobs"
      enableDraft={true}
      inputErrors={inputErrors}
      submitLabel={t.jobs.submitJob}
    />
  )}
</PageLayout>

<script>
  import { authClient } from "@/utils/auth-client"

  const resendButton = document.getElementById("resend-verification-btn")

  resendButton?.addEventListener("click", async () => {
    const email = resendButton.dataset.email
    if (!email) return

    resendButton.setAttribute("disabled", "true")
    await authClient.sendVerificationEmail({ email, callbackURL: "/login?confirmed=true" })
    resendButton.textContent = resendButton.dataset.sentLabel ?? resendButton.textContent
  })
</script>
