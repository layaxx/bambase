---
import AppLayout from "@/layouts/AppLayout.astro"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)
---

<AppLayout title={t.auth.forgotPasswordTitle}>
  <main class="flex justify-center px-4 py-12 grow" id="main-content">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-extrabold mb-2">{t.auth.forgotPasswordTitle}</h1>
      <p class="text-base-content/70 text-sm mb-6">{t.auth.forgotPasswordInstruction}</p>

      <div class="alert alert-success mb-4 hidden" id="forgot-success">
        {/* The page shows this alert after each submit, thus the user cannot find out if an account exists */}
        <span>{t.auth.forgotPasswordSuccess}</span>
      </div>

      <form class="flex flex-col" id="forgot-form" method="POST">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t.auth.emailLabel}</legend>
          <input
            autocomplete="email"
            class="input w-full"
            name="email"
            placeholder={t.auth.emailPlaceholder}
            required
            type="email"
          />
        </fieldset>

        <button class="btn btn-primary mt-6" type="submit">
          {t.auth.forgotPasswordBtn}
        </button>
      </form>

      <p class="text-base-content/70 text-sm mt-4">
        <a class="link link-primary" href="/login">
          {t.auth.loginLink}
        </a>
      </p>
    </div>
  </main>
  <script>
    import { authClient } from "@/utils/auth-client"

    const form = document.getElementById("forgot-form") as HTMLFormElement | null
    const successElement = document.getElementById("forgot-success")

    form?.addEventListener("submit", async (event) => {
      event.preventDefault()

      const submitButton = form.querySelector<HTMLButtonElement>('[type="submit"]')
      if (submitButton) submitButton.disabled = true

      const formData = new FormData(form)
      const email = formData.get("email") as string

      try {
        await authClient.requestPasswordReset({ email, redirectTo: "/reset-password" })
      } finally {
        form.classList.add("hidden")
        successElement?.classList.remove("hidden")
      }
    })
  </script>
</AppLayout>
