---
import PageLayout from "@/layouts/PageLayout.astro"
import PageHeader from "@/components/PageHeader.astro"
import IconUtensils from "@/components/icons/IconUtensils.astro"
import IconExternalLink from "@/components/icons/IconExternalLink.astro"
import MensaDaySection from "@/components/mensa/MensaDaySection.astro"
import MensaWeekendSection from "@/components/mensa/MensaWeekendSection.astro"
import { fetchMensaMealsRange } from "@/utils/api/mensa"
import { addDays, isoDay } from "@/utils/dates"
import { groupMealsByDay } from "@/utils/mensa"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)
const officialMenuUrl = "https://www.swerk-wue.de/bamberg/essen-trinken/mensen-speiseplaene"

const today = new Date()
const days = Array.from({ length: 7 }, (_, i) => addDays(today, i))

const allMeals = await fetchMensaMealsRange(days)
const mealsByDay = days.map((day) => ({
  day,
  meals: allMeals.filter((m) => m.date === isoDay(day)),
}))

const grouped = groupMealsByDay(mealsByDay, {
  today: t.mensa.today,
  tomorrow: t.mensa.tomorrow,
  weekdays: t.mensa.weekdays,
  weekendHeading: t.mensa.weekendHeading,
  dateLocale: t.mensa.dateLocale,
})
---

<PageLayout description={t.mensa.pageSubtitle} title={t.mensa.pageTitle}>
  <PageHeader color="warning" subtitle={t.mensa.pageSubtitle} title={t.mensa.pageTitle}>
    <IconUtensils class="h-5 w-5" slot="icon" />
  </PageHeader>

  <p class="-mt-3 mb-6 text-xs text-base-content/70">
    {t.mensa.sourceNoteBefore}{" "}
    <a
      class="link inline-flex items-center gap-0.5"
      href={officialMenuUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      Studierendenwerk Würzburg
      <IconExternalLink class="h-3 w-3" />
    </a>{" "}
    {t.mensa.sourceNoteAfter}
  </p>

  <div class="flex flex-col gap-10">
    {grouped.map((entry) =>
      entry.type === "weekend" ? (
        <MensaWeekendSection heading={entry.heading} id={entry.id} />
      ) : (
        <MensaDaySection heading={entry.heading} id={entry.id} meals={entry.meals} />
      )
    )}
  </div>
</PageLayout>
