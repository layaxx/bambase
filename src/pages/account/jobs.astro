---
import { lastPageRedirect, parsePageParam } from "@/utils/pagination"
import { actions } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import IconBriefcase from "@/components/icons/IconBriefcase.astro"
import IconPencil from "@/components/icons/IconPencil.astro"
import IconArchive from "@/components/icons/IconArchive.astro"
import ApiDownBanner from "@/components/ApiDownBanner.astro"
import Pagination from "@/components/Pagination.astro"
import SearchForm from "@/components/SearchForm.astro"
import ConfirmModal from "@/components/ConfirmModal.astro"
import Alert from "@/components/Alert.astro"
import EmptyState from "@/components/EmptyState.astro"
import { fetchMyJobOffers } from "@/utils/api/job-offers"
import { JOB_STATUS_BADGE_CLASS, canArchiveJob, canEditJob } from "@/utils/job-status"
import { formatJobLocation, formatRelativeDate } from "@/utils/job-formatting"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)

const user = Astro.locals.user
if (!user) return Astro.redirect("/login?redirect=/account/jobs")

// After archiving, return to the same page and search, minus Astro's action marker.
const listParams = new URLSearchParams(Astro.url.searchParams)
listParams.delete("_action")
const archiveResult = Astro.getActionResult(actions.jobs.archive)
if (archiveResult && !archiveResult.error) {
  return Astro.redirect(listParams.size ? `/account/jobs?${listParams}` : "/account/jobs")
}
const archiveFormAction = `${actions.jobs.archive}${listParams.size ? `&${listParams}` : ""}`

const search = Astro.url.searchParams.get("search")?.trim() ?? ""
const currentPage = parsePageParam(Astro.url)
const { data, apiDown } = await fetchMyJobOffers(user.id, { page: currentPage, search })
const { jobs, total, pageCount } = data
const lastPage = lastPageRedirect(Astro.url, currentPage, pageCount)
// A failed archive renders its error here, as a redirect would drop it.
if (!apiDown && !archiveResult?.error && lastPage) return Astro.redirect(lastPage)
// No listings at all, as opposed to none matching the search.
const hasNoJobs = !apiDown && total === 0 && !search

const statusLabel: Record<string, string> = {
  submitted: t.auth.statusSubmitted,
  published: t.auth.statusPublished,
  expired: t.auth.statusExpired,
  rejected: t.auth.statusRejected,
  archived: t.auth.statusArchived,
}
---

<PageLayout title={t.auth.myJobOffers}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/account">
      <IconArrowLeft class="h-4 w-4" />
      {t.nav.myAccount}
    </a>
  </div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.auth.myJobOffers}</h1>
    {!hasNoJobs && (
      <a class="btn btn-primary btn-sm" href="/job/new">
        {t.jobs.postJob}
      </a>
    )}
  </div>

  {!apiDown && !hasNoJobs && <SearchForm class="flex" value={search} />}

  {archiveResult?.error && <Alert variant="error">{archiveResult.error.message}</Alert>}

  {apiDown ? (
    <ApiDownBanner />
  ) : jobs.length === 0 && search ? (
    <EmptyState
      action={{ href: "/account/jobs", label: t.jobs.clearFilters }}
      icon={IconBriefcase}
      text={t.jobs.noJobsFoundHint}
      title={t.jobs.noJobsFoundTitle}
    />
  ) : hasNoJobs ? (
    <EmptyState
      action={{ href: "/job/new", label: t.jobs.postJob }}
      badge="badge-success"
      icon={IconBriefcase}
      text={t.auth.noMyJobOffers}
    />
  ) : (
    <>
      <ul class="list rounded-box border border-base-300 bg-base-100">
        {jobs.map((job) => (
          <li class="list-row items-center transition-colors hover:bg-base-200/50">
            <div class="list-col-grow min-w-0">
              {/* after:inset-0 stretches the link over the whole row for a bigger tap target */}
              <a
                class="link link-hover line-clamp-2 font-semibold after:absolute after:inset-0"
                href={`/job/${job.slug}`}
              >
                {job.title}
              </a>
              <p class="mt-1 text-sm text-base-content/70">
                <span
                  class:list={[
                    "badge badge-sm mr-1",
                    JOB_STATUS_BADGE_CLASS[job.online_status] ?? "badge-neutral",
                  ]}
                >
                  {statusLabel[job.online_status] ?? job.online_status}
                </span>
                {job.company} ·{" "}
                <span class="max-sm:hidden">
                  {formatJobLocation(job, {
                    remote: t.jobs.workModes.remote,
                    hybrid: t.jobs.workModes.hybrid,
                  })}{" "}
                  ·{" "}
                </span>
                {formatRelativeDate(job.createdAt, Astro.locals.locale)}
              </p>
              {job.online_status === "rejected" && (
                <p class="mt-1 text-sm text-error">
                  {job.rejection_reason &&
                    `${t.jobs.rejectionReasonLabel(job.rejection_reason)} – `}
                  {t.jobs.rejectedResubmitHint}
                </p>
              )}
            </div>
            {/* An archivable listing is always editable, thus canEditJob covers both buttons. */}
            {canEditJob(job.online_status) && (
              <div class="flex gap-1">
                {canArchiveJob(job.online_status) && (
                  <button
                    class="btn btn-ghost btn-sm relative max-sm:btn-square"
                    onclick={`const m = document.getElementById('archive-modal'); m.querySelector('[name=id]').value = '${job.id}'; m.showModal()`}
                    type="button"
                  >
                    <IconArchive class="h-4 w-4 sm:hidden" />
                    <span class="sr-only sm:not-sr-only">{t.jobs.archiveJob}</span>
                  </button>
                )}
                <a
                  class:list={[
                    "btn btn-sm relative max-sm:btn-square",
                    {
                      "btn-soft btn-primary": job.online_status === "rejected",
                      "btn-ghost": job.online_status !== "rejected",
                    },
                  ]}
                  href={`/job/${job.slug}/edit`}
                >
                  <IconPencil class="h-4 w-4 sm:hidden" />
                  <span class="sr-only sm:not-sr-only">{t.jobs.editJob}</span>
                </a>
              </div>
            )}
          </li>
        ))}
      </ul>
      {/* One modal for all rows: the row's button fills in the job id before opening it. */}
      <ConfirmModal
        confirmClass="btn btn-warning"
        confirmLabel={t.jobs.archiveJob}
        formAction={archiveFormAction}
        hiddenInputs={[{ name: "id", value: "" }]}
        id="archive-modal"
        message={t.jobs.archiveConfirm}
      />
    </>
  )}

  <Pagination
    nextLabel={t.jobs.paginationNext}
    page={currentPage}
    pageCount={pageCount}
    prevLabel={t.jobs.paginationPrev}
  />
</PageLayout>
