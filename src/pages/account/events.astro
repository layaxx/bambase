---
import PageLayout from "@/layouts/PageLayout.astro"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import IconCalendar from "@/components/icons/IconCalendar.astro"
import IconPencil from "@/components/icons/IconPencil.astro"
import ApiDownBanner from "@/components/ApiDownBanner.astro"
import Pagination from "@/components/Pagination.astro"
import SearchForm from "@/components/SearchForm.astro"
import { fetchMyEvents } from "@/utils/api/events"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)

const user = Astro.locals.user
if (!user) return Astro.redirect("/login?redirect=/account/events")

const search = Astro.url.searchParams.get("search")?.trim() ?? ""
const rawPage = parseInt(Astro.url.searchParams.get("page") ?? "1", 10)
const currentPage = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage
const { data, apiDown } = await fetchMyEvents(user.id, { page: currentPage, search })
const { events, total, pageCount } = data
if (!apiDown && currentPage > pageCount) {
  const params = new URLSearchParams(Astro.url.searchParams)
  params.set("page", String(pageCount))
  return Astro.redirect(`/account/events?${params}`)
}
// No events at all, as opposed to none matching the search.
const hasNoEvents = !apiDown && total === 0 && !search

const dateLocale = t.mensa.dateLocale

function formatDateTime(iso: string) {
  return new Date(iso).toLocaleString(dateLocale, {
    weekday: "short",
    day: "numeric",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
  })
}
---

<PageLayout title={t.auth.myEvents}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/account">
      <IconArrowLeft class="h-4 w-4" />
      {t.nav.myAccount}
    </a>
  </div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.auth.myEvents}</h1>
    {!hasNoEvents && (
      <a class="btn btn-primary btn-sm" href="/event/new">
        {t.events.submitEvent}
      </a>
    )}
  </div>

  {!apiDown && !hasNoEvents && (
    <SearchForm class="flex" placeholder={t.events.searchPlaceholder} value={search} />
  )}

  {apiDown ? (
    <ApiDownBanner />
  ) : events.length === 0 && search ? (
    <div class="rounded-xl border border-base-300 py-16 text-center">
      <IconCalendar class="mx-auto mb-4 h-10 w-10 text-base-content/40" />
      <p class="mb-4 text-sm text-base-content/70">{t.events.noEventsFiltered}</p>
      <a class="btn btn-outline btn-sm" href="/account/events">
        {t.events.clearFilters}
      </a>
    </div>
  ) : hasNoEvents ? (
    <div class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-base-300 bg-base-100 p-10 text-center">
      <div class="flex h-12 w-12 items-center justify-center rounded-lg badge-soft badge-primary">
        <IconCalendar class="h-6 w-6" />
      </div>
      <p class="text-base-content/70">{t.auth.noMyEvents}</p>
      <a class="btn btn-primary btn-sm" href="/event/new">
        {t.events.submitEvent}
      </a>
    </div>
  ) : (
    <ul class="list rounded-box border border-base-300 bg-base-100">
      {events.map((event) => (
        <li class="list-row items-center transition-colors hover:bg-base-200/50">
          <div class="list-col-grow min-w-0">
            {/* after:inset-0 stretches the link over the whole row for a bigger tap target */}
            <a
              class="link link-hover line-clamp-2 font-semibold after:absolute after:inset-0"
              href={`/event/${event.slug}`}
            >
              {event.title}
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              {event.hidden && (
                <span class="badge badge-sm badge-ghost mr-1">{t.events.unpublishedBadge}</span>
              )}
              {formatDateTime(event.start)}
              <span class="max-sm:hidden"> · {event.organizer}</span>
            </p>
            {event.hidden && event.rejection_reason && (
              <p class="mt-1 text-sm text-error">
                {t.events.rejectionReasonLabel(event.rejection_reason)}
              </p>
            )}
          </div>
          <a
            class="btn btn-ghost btn-sm relative max-sm:btn-square"
            href={`/event/${event.slug}/edit`}
          >
            <IconPencil class="h-4 w-4 sm:hidden" />
            <span class="sr-only sm:not-sr-only">{t.events.editEvent}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  <Pagination
    nextLabel={t.jobs.paginationNext}
    page={currentPage}
    pageCount={pageCount}
    prevLabel={t.jobs.paginationPrev}
  />
</PageLayout>
