---
import AppLayout from "@/layouts/AppLayout.astro"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)

// better-auth redirects to this page with `?token=...` after the user clicks the reset link
// in the email (see the `redirectTo` option in src/pages/forgot-password.astro).
const token = Astro.url.searchParams.get("token") || ""
const missingToken = !token
---

<AppLayout title={t.auth.resetPasswordTitle}>
  <main class="flex justify-center px-4 py-12 grow" id="main-content">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-extrabold mb-2">{t.auth.resetPasswordTitle}</h1>

      {missingToken && (
        <>
          <div class="alert alert-error mb-4">
            <span>{t.auth.resetPasswordInvalidCode}</span>
          </div>
          <p class="text-base-content/70 text-sm mt-4">
            <a class="link link-primary" href="/forgot-password">
              {t.auth.forgotPasswordLink}
            </a>
          </p>
        </>
      )}

      {!missingToken && (
        <>
          <div class="alert alert-success mb-4 hidden" id="reset-success">
            <span>{t.auth.resetPasswordSuccess}</span>
          </div>
          <p class="text-base-content/70 text-sm mt-4 hidden" id="reset-success-login-link">
            <a class="link link-primary" href="/login">
              {t.auth.loginLink}
            </a>
          </p>

          <div id="reset-form-wrapper">
            <p class="text-base-content/70 text-sm mb-6">{t.auth.resetPasswordInstruction}</p>

            <div class="alert alert-error mb-4 hidden" id="reset-error">
              <span />
            </div>

            <form
              class="flex flex-col"
              data-locale={Astro.locals.locale}
              data-token={token}
              id="reset-form"
            >
              <fieldset class="fieldset">
                <legend class="fieldset-legend">{t.auth.resetPasswordNewLabel}</legend>
                <input
                  autocomplete="new-password"
                  class="input w-full"
                  minlength="10"
                  name="password"
                  placeholder={t.auth.passwordPlaceholder}
                  required
                  type="password"
                />
                <p class="fieldset-label">{t.auth.passwordMinHint}</p>
              </fieldset>

              <fieldset class="fieldset">
                <legend class="fieldset-legend">{t.auth.resetPasswordConfirmLabel}</legend>
                <input
                  autocomplete="new-password"
                  class="input w-full"
                  name="passwordConfirm"
                  placeholder={t.auth.confirmPasswordPlaceholder}
                  required
                  type="password"
                />
              </fieldset>

              <button class="btn btn-primary mt-6" type="submit">
                {t.auth.resetPasswordBtn}
              </button>
            </form>
          </div>
        </>
      )}
    </div>
  </main>
  <script>
    import { authClient } from "@/utils/auth-client"

    const form = document.getElementById("reset-form") as HTMLFormElement | null
    const formWrapper = document.getElementById("reset-form-wrapper")
    const errorElement = document.getElementById("reset-error")
    const successElement = document.getElementById("reset-success")
    const successLinkElement = document.getElementById("reset-success-login-link")

    const locale: "de" | "en" = form?.dataset.locale === "en" ? "en" : "de"
    const token = form?.dataset.token ?? ""

    function showError(text: string) {
      if (!errorElement) return
      errorElement.classList.remove("hidden")
      const span = errorElement.querySelector("span")
      if (span) span.textContent = text
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault()
      errorElement?.classList.add("hidden")

      const submitButton = form.querySelector<HTMLButtonElement>('[type="submit"]')

      const formData = new FormData(form)
      const password = formData.get("password") as string
      const passwordConfirm = formData.get("passwordConfirm")

      if (password !== passwordConfirm) {
        showError(
          {
            en: "The passwords do not match.",
            de: "Die Passwörter stimmen nicht überein.",
          }[locale]
        )
        return
      }
      if (password.length < 10) {
        showError(
          {
            en: "Your password must be at least 10 characters long.",
            de: "Das Passwort muss mindestens 10 Zeichen lang sein.",
          }[locale]
        )
        return
      }

      if (submitButton) submitButton.disabled = true

      const response = await authClient.resetPassword({ newPassword: password, token })

      if (!response.error) {
        formWrapper?.classList.add("hidden")
        successElement?.classList.remove("hidden")
        successLinkElement?.classList.remove("hidden")
      } else {
        if (submitButton) submitButton.disabled = false

        let msg = {
          de: "Ein Fehler ist aufgetreten. Bitte später erneut versuchen.",
          en: "An unknown error has occurred. Please try again later.",
        }

        if (response.error.code === "INVALID_TOKEN") {
          msg = {
            de: "Der Reset-Link ist ungültig oder abgelaufen.",
            en: "The reset link is invalid or has expired.",
          }
        } else if (response.error.status === 500) {
          msg = {
            de: "Serverfehler. Bitte später erneut versuchen.",
            en: "Server Error. Please try again later.",
          }
        }

        showError(msg[locale])
      }
    })
  </script>
</AppLayout>
