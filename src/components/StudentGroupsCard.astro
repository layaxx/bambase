---
import Sidebar from "./Sidebar.astro"
import StudentGroup from "./StudentGroup.astro"
import type { StudentGroup as Group } from "@/utils/api/student-groups"
import { useTranslations } from "@/i18n/translations"
import IconUsers from "./icons/IconUsers.astro"

const t = useTranslations(Astro.locals.locale)
interface Props {
  groups: Group[]
}
const { groups } = Astro.props

const LIMIT = 4
---

<section id="groups">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg badge-soft badge-secondary">
        <IconUsers class="h-5 w-5" />
      </div>
      <div>
        <h2 class="text-xl font-semibold">{t.groups.title}</h2>
        <p class="text-sm text-base-content/70">{t.groups.subtitle}</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    <div class="md:col-span-2">
      <p class="text-sm text-base-content/70 mb-4">{t.groups.description}</p>
      <select class="select select-bordered select-sm mb-6 w-auto" id="sort-select">
        <option value="random">{t.groups.sortRandom}</option>
        <option value="name">{t.groups.sortByName}</option>
      </select>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2" id="main-grid">
        {groups.map((group, i) => (
          <div data-group data-group-name={group.name} hidden={i >= LIMIT}>
            <StudentGroup group={group} />
          </div>
        ))}
      </div>

      <button class="btn btn-soft btn-sm mt-4" id="show-all-btn">
        {t.groups.showAll(groups.length)}
      </button>
    </div>

    <Sidebar />
  </div>
</section>

<script
  define:vars={{ LIMIT, showAllText: t.groups.showAll(groups.length), showLessText: t.groups.showLess }}
  is:inline
>
  const grid = document.getElementById("main-grid")
  const sortSelect = document.getElementById("sort-select")
  const showAllBtn = document.getElementById("show-all-btn")
  let showAll = false

  function getGroups() {
    return [...grid.querySelectorAll("[data-group]")]
  }

  function updateVisibility() {
    getGroups().forEach((el, i) => {
      el.hidden = !showAll && i >= LIMIT
    })
  }

  function sortGroups(order) {
    const groupEls = getGroups()
    if (order === "name") {
      groupEls.sort((a, b) => a.dataset.groupName.localeCompare(b.dataset.groupName))
    } else {
      groupEls.sort(() => Math.random() - 0.5)
    }
    groupEls.forEach((el) => grid.appendChild(el))
    updateVisibility()
  }

  sortSelect.addEventListener("change", (e) => sortGroups(e.target.value))

  showAllBtn.addEventListener("click", () => {
    showAll = !showAll
    showAllBtn.textContent = showAll ? showLessText : showAllText
    updateVisibility()
  })

  sortGroups("random")
</script>
