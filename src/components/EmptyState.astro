---
import type { AstroComponentFactory } from "astro/runtime/server/index.js"

interface Props {
  icon: AstroComponentFactory
  text: string
  title?: string
  /** A button below the text, for example to clear a search or to create the first item. */
  action?: { href: string; label: string }
  /**
   * Set when the user has no items yet: a dashed box with the icon in a badge of this colour and
   * a primary button. Without it, the box tells that no item matches a search or filter.
   */
  badge?: "badge-primary" | "badge-success"
}

const { icon: Icon, text, title, action, badge } = Astro.props
---

{badge ? (
  <div class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-base-300 bg-base-100 p-10 text-center">
    <div class:list={["flex h-12 w-12 items-center justify-center rounded-lg badge-soft", badge]}>
      <Icon class="h-6 w-6" />
    </div>
    <p class="text-base-content/70">{text}</p>
    {action && (
      <a class="btn btn-primary btn-sm" href={action.href}>
        {action.label}
      </a>
    )}
  </div>
) : (
  <div class="rounded-xl border border-base-300 py-16 text-center">
    <Icon class="mx-auto mb-4 h-10 w-10 text-base-content/40" />
    {title && <p class="mb-1 font-medium">{title}</p>}
    <p class="mb-4 text-sm text-base-content/70">{text}</p>
    {action && (
      <a class="btn btn-outline btn-sm" href={action.href}>
        {action.label}
      </a>
    )}
  </div>
)}
