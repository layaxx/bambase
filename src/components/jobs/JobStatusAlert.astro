---
import type { JobOffer } from "@/utils/api/job-offers"
import { JOB_STATUS_ALERT_VARIANT } from "@/utils/job-status"
import { REPORT_WARNING_THRESHOLD } from "@/utils/api/reports"
import { useTranslations } from "@/i18n/translations"
import Alert from "@/components/Alert.astro"

interface Props {
  job: JobOffer
}

const { job } = Astro.props
const t = useTranslations(Astro.locals.locale)
const hasReports = (job.reports?.length ?? 0) >= REPORT_WARNING_THRESHOLD

const statusLabel: Record<string, string> = {
  submitted: t.auth.statusSubmitted,
  expired: t.auth.statusExpired,
  rejected: t.auth.statusRejected,
  archived: t.auth.statusArchived,
}
---

{job.online_status !== "published" && (
  <Alert variant={JOB_STATUS_ALERT_VARIANT[job.online_status] ?? "neutral"}>
    {statusLabel[job.online_status] ?? job.online_status} – {t.jobs.notPublishedHint}
    {job.online_status === "submitted" && (
      <>
        <br /> {t.jobs.submittedReviewHint}
      </>
    )}
    {job.online_status === "rejected" && (
      <>
        {job.rejection_reason && (
          <>
            <br /> {t.jobs.rejectionReasonLabel(job.rejection_reason)}
          </>
        )}
        <br /> {t.jobs.rejectedResubmitHint}
      </>
    )}
  </Alert>
)}
{hasReports && (
  <Alert outline variant="warning">
    {t.reports.warningHint}
  </Alert>
)}
