---
import { actions } from "astro:actions"
import type { JobOffer } from "@/utils/api/job-offers"
import { canArchiveJob, canEditJob } from "@/utils/job-status"
import { useTranslations } from "@/i18n/translations"
import IconPencil from "@/components/icons/IconPencil.astro"
import IconArchive from "@/components/icons/IconArchive.astro"
import IconTrash from "@/components/icons/IconTrash.astro"
import ConfirmModal from "@/components/ConfirmModal.astro"

interface Props {
  job: JobOffer
}

const { job } = Astro.props
const t = useTranslations(Astro.locals.locale)
const canArchive = canArchiveJob(job.online_status)
---

<div class="flex items-center gap-2 max-sm:w-full">
  <a class="btn btn-ghost btn-sm max-sm:mr-auto max-sm:pl-0" href="/account/jobs">
    {t.auth.myJobOffers}
  </a>
  {canEditJob(job.online_status) && (
    <a class="btn btn-outline btn-sm relative max-sm:btn-square" href={`/job/${job.slug}/edit`}>
      <IconPencil class="h-4 w-4 sm:hidden" />
      <span class="sr-only sm:not-sr-only">{t.jobs.editJob}</span>
    </a>
  )}
  {canArchive && (
    <button
      class="btn btn-outline btn-sm relative max-sm:btn-square"
      onclick="document.getElementById('archiveJobModal').showModal()"
      type="button"
    >
      <IconArchive class="h-4 w-4 sm:hidden" />
      <span class="sr-only sm:not-sr-only">{t.jobs.archiveJob}</span>
    </button>
  )}
  <button
    class="btn btn-outline btn-error btn-sm relative max-sm:btn-square"
    onclick="document.getElementById('deleteJobModal').showModal()"
    type="button"
  >
    <IconTrash class="h-4 w-4 sm:hidden" />
    <span class="sr-only sm:not-sr-only">{t.jobs.deleteJob}</span>
  </button>
</div>

{canArchive && (
  <ConfirmModal
    confirmClass="btn btn-warning"
    confirmLabel={t.jobs.archiveJob}
    formAction={actions.jobs.archive}
    hiddenInputs={[{ name: "id", value: job.id }]}
    id="archiveJobModal"
    message={t.jobs.archiveConfirm}
  />
)}
<ConfirmModal
  confirmClass="btn btn-error"
  confirmLabel={t.jobs.deleteJob}
  formAction={actions.jobs.delete}
  hiddenInputs={[{ name: "id", value: job.id }]}
  id="deleteJobModal"
  message={t.jobs.deleteConfirm}
/>
