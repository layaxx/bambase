---
import type { JobOffer } from "@/utils/api/job-offers"
import { useTranslations } from "@/i18n/translations"
import IconStore from "../icons/IconStore.astro"
import IconMapPin from "../icons/IconMapPin.astro"
import IconClock from "../icons/IconClock.astro"
import { formatRelativeDate } from "@/utils/job-formatting"
import JobTypeBadge from "./JobTypeBadge.astro"

interface Props {
  job: JobOffer
}

const { job } = Astro.props
const t = useTranslations(Astro.locals.locale)
---

<a
  class="group flex min-w-0 flex-col rounded-xl border border-base-300 bg-base-100 p-4 transition-all hover:shadow-md no-underline h-full"
  href={`/job/${job.slug}`}
>
  <div class="mb-2 flex flex-row items-center justify-between">
    <JobTypeBadge isSmall jobType={job.job_type} />
    <span class="shrink-0 text-xs text-base-content/70">
      {formatRelativeDate(job.createdAt, Astro.locals.locale)}
    </span>
  </div>
  <h3 class="mb-1 font-semibold leading-tight text-base-content group-hover:text-primary">
    {job.title}
  </h3>
  <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/70">
    <span class="flex min-w-0 items-center gap-1.5">
      <IconStore class="h-3.5 w-3.5 shrink-0" />
      <span class="truncate">{job.company}</span>
    </span>
    {job.work_mode !== "remote" && job.location && (
      <span class="flex items-center gap-1.5">
        <IconMapPin class="h-3.5 w-3.5 shrink-0" />
        {job.location}
      </span>
    )}
    {job.work_mode !== "on_site" && (
      <span class="badge badge-ghost badge-sm">{t.jobs.workModes[job.work_mode]}</span>
    )}
    <span class="flex items-center gap-1.5">
      <IconClock class="h-3.5 w-3.5 shrink-0" />
      {t.jobs.workingHours(job.working_hours)}
    </span>
  </div>
  <p class="mb-3 line-clamp-2 text-sm text-base-content/70">{job.description}</p>
  {job.field !== "other" && (
    <span class="mt-auto badge badge-ghost badge-sm max-w-full truncate">
      {t.jobs.jobFields[job.field]}
    </span>
  )}
</a>
