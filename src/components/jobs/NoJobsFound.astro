---
import IconBriefcase from "@/components/icons/IconBriefcase.astro"
import { useTranslations } from "@/i18n/translations"

interface Props {
  /** Set when a filter or search is active: shows the hint and a button that clears them. */
  clearUrl?: string
}

const { clearUrl } = Astro.props
const t = useTranslations(Astro.locals.locale)
---

<div class="rounded-xl border border-base-300 py-16 text-center">
  <IconBriefcase class="mx-auto mb-4 h-10 w-10 text-base-content/40" />
  <p class="mb-1 font-medium">{t.jobs.noJobsFoundTitle}</p>
  <p class="mb-4 text-sm text-base-content/70">
    {clearUrl ? t.jobs.noJobsFoundHint : t.jobs.noJobs}
  </p>
  {clearUrl && (
    <a class="btn btn-outline btn-sm" href={clearUrl}>
      {t.jobs.clearFilters}
    </a>
  )}
</div>
