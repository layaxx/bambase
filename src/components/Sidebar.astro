---
import { useTranslations } from "@/i18n/translations"
import { HELP_EMAIL } from "@/utils/mail"

const t = useTranslations(Astro.locals.locale)
const joinSubject = encodeURIComponent(`BamBase: ${t.groups.sidebarJoinSubject}`)
---

<aside class="flex flex-col gap-4 max-md:order-first md:row-span-2 md:col-start-3">
  <div class="rounded-xl border border-base-300 bg-base-100 overflow-hidden">
    <h3 class="bg-base-200 px-4 py-3 font-semibold text-base-content">
      {t.groups.sidebarAboutTitle}
    </h3>
    <p class="p-4 text-sm text-base-content/70">{t.groups.sidebarAboutText}</p>
  </div>

  <div class="rounded-xl border border-base-300 bg-base-100 overflow-hidden">
    <h3 class="bg-base-200 px-4 py-3 font-semibold text-base-content">
      {t.groups.sidebarResponsibleTitle}
    </h3>
    <ul class="flex flex-col gap-2 p-4 text-sm">
      {t.groups.sidebarResponsible.map(({ name, role }) => (
        <li class="flex justify-between gap-2">
          <span class="text-base-content">{name}</span>
          <span class="text-base-content/70">{role}</span>
        </li>
      ))}
    </ul>
    <p class="border-t border-base-300 px-4 py-3 text-sm text-base-content/70">
      {t.groups.sidebarJoinHint}{" "}
      <a class="link link-primary" href={`mailto:${HELP_EMAIL}?subject=${joinSubject}`}>
        {t.groups.sidebarJoinLink}
      </a>
    </p>
  </div>
</aside>
