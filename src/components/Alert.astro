---
interface Props {
  variant: "success" | "error" | "warning" | "neutral" | "info"
  outline?: boolean
  class?: string
}

const { variant, outline = false, class: className } = Astro.props
---

<div
  class:list={["alert mb-6", `alert-${variant}`, outline && "alert-outline", className]}
  role="alert"
>
  <span><slot /></span>
</div>
