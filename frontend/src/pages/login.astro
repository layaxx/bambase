---
import AppLayout from "@/layouts/AppLayout.astro"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)

const emailConfirmed = Astro.url.searchParams.get("confirmed") === "true"
---

<AppLayout title={t.auth.loginTitle}>
  <main class="flex justify-center px-4 py-12 grow" id="main-content">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-extrabold mb-2">{t.auth.loginTitle}</h1>
      <p class="text-base-content/70 text-sm mb-6">
        {t.auth.noAccount}
        <a class="link link-primary" href="/register">{t.auth.registerLink}</a>
      </p>

      {
        emailConfirmed && (
          <div class="alert alert-success mb-4">
            <div>
              <h3 class="font-bold">{t.auth.emailConfirmed}</h3>
              <p>{t.auth.emailConfirmedYouCanLogin}</p>
            </div>
          </div>
        )
      }

      <div class="alert alert-error mb-4 hidden" id="signin-error">
        <span></span>
      </div>

      <form class="flex flex-col" data-locale={Astro.locals.locale} id="signin-form">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t.auth.emailLabel}</legend>
          <input
            autocomplete="email"
            class="input w-full"
            name="identifier"
            placeholder={t.auth.emailPlaceholder}
            required
            type="email"
          />
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t.auth.passwordLabel}</legend>
          <input
            autocomplete="current-password"
            class="input w-full"
            name="password"
            placeholder={t.auth.passwordPlaceholder}
            required
            type="password"
          />
        </fieldset>

        <button class="btn btn-primary mt-6" type="submit">{t.auth.loginBtn}</button>
      </form>

      <p class="text-base-content/70 text-sm mt-4">
        <a class="link link-primary" href="/forgot-password">{t.auth.forgotPasswordLink}</a>
      </p>
    </div>
  </main>
  <script>
    import { authClient } from "@/utils/auth-client"
    import { safeRedirect } from "@/utils/safe-redirect"

    const form = document.getElementById("signin-form")

    const locale: "de" | "en" = form?.dataset.locale === "en" ? "en" : "de"

    form?.addEventListener("submit", async (event) => {
      event.preventDefault()

      const submitButton = form.querySelector<HTMLButtonElement>('[type="submit"]')
      if (submitButton) submitButton.disabled = true

      const formData = new FormData(event.target as HTMLFormElement)
      const email = formData.get("identifier") as string
      const password = formData.get("password") as string
      const authResponse = await authClient.signIn.email({
        email,
        password,
      })
      if (Boolean(authResponse.error) === false) {
        window.location.href = safeRedirect(
          new URLSearchParams(window.location.search).get("redirect"),
          window.location.href
        )
      } else {
        if (submitButton) submitButton.disabled = false

        const errorDiv = document.getElementById("signin-error")
        if (errorDiv) {
          errorDiv.classList.remove("hidden")
          const textElem = errorDiv.querySelector("span")
          if (textElem) {
            let msg = {
              de: "Ein unbekannter Fehler ist aufgetreten.",
              en: "An unknown error occurred.",
            }

            if (authResponse.error?.status === 500) {
              msg = {
                de: "Serverfehler. Bitte später erneut versuchen.",
                en: "Server Error. Please try again later.",
              }
            } else if (authResponse.error?.code === "INVALID_EMAIL_OR_PASSWORD") {
              msg = {
                en: "Invalid email or password.",
                de: "E-Mail oder Passwort ungültig.",
              }
            } else if (authResponse.error?.code === "EMAIL_NOT_VERIFIED") {
              msg = {
                en: "Please verify your email address first. We've sent you a new verification link.",
                de: "Bitte bestätige zuerst deine E-Mail-Adresse. Wir haben dir einen neuen Bestätigungslink gesendet.",
              }
            }
            textElem.textContent = msg[locale]
          }
        }
      }
    })
  </script>
</AppLayout>
