---
import AppLayout from "@/layouts/AppLayout.astro"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)
---

<AppLayout title={t.auth.registerTitle}>
  <main class="flex justify-center px-4 py-12 grow" id="main-content">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-extrabold mb-2">{t.auth.registerTitle}</h1>
      <p class="text-base-content/70 text-sm mb-6">
        {t.auth.alreadyRegistered}
        <a class="link link-primary" href="/login">
          {t.auth.loginLink}
        </a>
      </p>

      <div class="alert alert-error mb-4 hidden" id="signup-error">
        <span></span>
      </div>

      <form class="flex flex-col" data-locale={Astro.locals.locale} id="signup-form">
        <input name="locale" type="hidden" value={Astro.locals.locale} />
        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t.auth.emailLabel}</legend>
          <input
            autocomplete="email"
            class="input w-full"
            name="email"
            placeholder={t.auth.emailPlaceholder}
            required
            type="email"
          />
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t.auth.passwordLabel}</legend>
          <input
            autocomplete="new-password"
            class="input w-full"
            minlength="10"
            name="password"
            placeholder={t.auth.passwordMinHint}
            required
            type="password"
          />
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t.auth.confirmPasswordLabel}</legend>
          <input
            autocomplete="new-password"
            class="input w-full"
            name="passwordConfirm"
            placeholder={t.auth.confirmPasswordPlaceholder}
            required
            type="password"
          />
        </fieldset>

        <button class="btn btn-primary mt-6" type="submit">
          {t.auth.createAccountBtn}
        </button>
      </form>
    </div>
  </main>
  <script>
    import { authClient } from "@/utils/auth-client"

    const form = document.getElementById("signup-form")

    const locale = form?.dataset.locale === "en" ? "en" : "de"
    const errorElement = document.getElementById("signup-error")

    async function trySignup(
      event: SubmitEvent,
      locale: "de" | "en"
    ): Promise<{ error: string | undefined }> {
      const formData = new FormData(event.target as HTMLFormElement)
      const email = formData.get("email") as string
      const password = formData.get("password") as string
      const confirmPassword = formData.get("passwordConfirm")

      if (password !== confirmPassword) {
        return {
          error: {
            en: "The passwords do not match.",
            de: "Die Passwörter stimmen nicht überein.",
          }[locale],
        }
      }
      if (password.length < 10) {
        return {
          error: {
            en: "Your password must be at least 10 characters long.",
            de: "Das Passwort muss mindestens 10 Zeichen lang sein.",
          }[locale],
        }
      }

      const authResponse = await authClient.signUp.email({
        name: email,
        email,
        password,
        callbackURL: "/login?confirmed=true",
      })

      console.error(authResponse)
      if (Boolean(authResponse.error) === false) {
        window.location.href = "/account"
        return { error: undefined }
      } else {
        let msg = {
          de: "Ein Fehler ist aufgetreten. Bitter später erneut versuchen.",
          en: "An unknown error has occurred. Please try again later.",
        }

        if (authResponse.error?.status === 500) {
          msg = {
            de: "Serverfehler. Bitte später erneut versuchen.",
            en: "Server Error. Please try again later.",
          }
        } else if (authResponse.error?.code === "USER_ALREADY_EXISTS_USE_ANOTHER_EMAIL") {
          msg = {
            de: "E-Mail Adresse ungültig.",
            en: "Invalid email.",
          }
        } else if (authResponse.error?.code === "PASSWORD_TOO_LONG") {
          msg = { de: "Das Passwort ist zu lang.", en: "Password too long." }
        }

        return { error: msg[locale] }
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault()

      errorElement?.classList.add("hidden")

      const { error } = await trySignup(event, locale)

      if (error) {
        errorElement?.classList.remove("hidden")
        const textElem = errorElement?.querySelector("span")

        if (textElem) textElem.textContent = error
      }
    })
  </script>
</AppLayout>
