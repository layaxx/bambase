---
import PageLayout from "@/layouts/PageLayout.astro"
import {
  canModerateJobOffers,
  canModerateEvents,
  canManageLocations,
  canManageUsers,
} from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)

const user = Astro.locals.user
if (!user) return Astro.redirect("/login?redirect=/admin")

const [isJobModerator, isEventModerator, isLocationManager, isUserManager] = await Promise.all([
  canModerateJobOffers(user.role),
  canModerateEvents(user.role),
  canManageLocations(user.role),
  canManageUsers(user.role),
])

const sections = [
  {
    href: "/admin/jobs",
    title: t.admin.jobsQueueTitle,
    description: t.admin.overviewJobsDescription,
    visible: isJobModerator,
  },
  {
    href: "/admin/events",
    title: t.admin.eventsTitle,
    description: t.admin.overviewEventsDescription,
    visible: isEventModerator,
  },
  {
    href: "/admin/locations",
    title: t.admin.locationsTitle,
    description: t.admin.overviewLocationsDescription,
    visible: isLocationManager,
  },
  {
    href: "/admin/users",
    title: t.admin.usersTitle,
    description: t.admin.overviewUsersDescription,
    visible: isUserManager,
  },
].filter((section) => section.visible)

if (sections.length === 0) return Astro.redirect("/")
---

<PageLayout title={t.admin.overviewTitle}>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">{t.admin.overviewTitle}</h1>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      sections.map((section) => (
        <a
          class="block rounded-xl border border-base-300 bg-base-100 p-4 no-underline transition-colors hover:bg-base-200"
          href={section.href}
        >
          <h2 class="font-semibold leading-snug text-base-content">{section.title}</h2>
          <p class="mt-1 text-sm text-base-content/70">{section.description}</p>
        </a>
      ))
    }
  </div>
</PageLayout>
