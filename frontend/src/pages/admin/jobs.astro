---
import { actions } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchSubmittedJobOffers, fetchRecentlyModeratedJobOffers } from "@/utils/api"
import { canModerateJobOffers } from "@/utils/authz"
import { JOB_STATUS_BADGE_CLASS } from "@/utils/job-status"
import { useTranslations } from "@/i18n/translations"

const t = useTranslations(Astro.locals.locale)

const user = Astro.locals.user
if (!user) return Astro.redirect("/login?redirect=/admin/jobs")
if (!(await canModerateJobOffers(user.role))) return Astro.redirect("/")

const approveResult = Astro.getActionResult(actions.jobs.approve)
const rejectResult = Astro.getActionResult(actions.jobs.reject)
if (
  (approveResult?.data !== undefined && !approveResult.error) ||
  (rejectResult?.data !== undefined && !rejectResult.error)
) {
  return Astro.redirect(Astro.url.pathname)
}

const { data: jobs } = await fetchSubmittedJobOffers()
const { data: recentlyModerated } = await fetchRecentlyModeratedJobOffers()

const statusLabel: Record<string, string> = {
  published: t.auth.statusPublished,
  rejected: t.auth.statusRejected,
}
---

<PageLayout title={t.admin.jobsQueueTitle}>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">{t.admin.jobsQueueTitle}</h1>

  {
    jobs.length === 0 ? (
      <p
        class="rounded-xl border border-base-300 bg-base-100 p-6 text-base-content/70"
        data-testid="job-queue"
      >
        {t.admin.noSubmittedJobs}
      </p>
    ) : (
      <div class="flex flex-col gap-3" data-testid="job-queue">
        {jobs.map((job) => (
          <div class="flex flex-col gap-3 rounded-xl border border-base-300 bg-base-100 p-4">
            <div>
              <h2 class="font-semibold leading-snug text-base-content">{job.title}</h2>
              <p class="text-sm text-base-content/70">
                {job.company} · {job.location}
              </p>
              <p class="line-clamp-2 text-sm text-base-content/40">{job.description}</p>
            </div>
            <div class="flex gap-2">
              <a class="btn btn-outline btn-sm" href={`/admin/jobs/${job.slug}/edit`}>
                {t.admin.editJob}
              </a>
              <form action={actions.jobs.approve} method="POST">
                <input name="id" type="hidden" value={job.id} />
                <button class="btn btn-success btn-sm" type="submit">
                  {t.admin.approveJob}
                </button>
              </form>
              <form action={actions.jobs.reject} method="POST">
                <input name="id" type="hidden" value={job.id} />
                <button class="btn btn-outline btn-error btn-sm" type="submit">
                  {t.admin.rejectJob}
                </button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )
  }

  <h2 class="text-2xl font-bold tracking-tight mt-12 mb-6">{t.admin.recentDecisionsTitle}</h2>

  {
    recentlyModerated.length === 0 ? (
      <p
        class="rounded-xl border border-base-300 bg-base-100 p-6 text-base-content/70"
        data-testid="recent-decisions"
      >
        {t.admin.noRecentDecisions}
      </p>
    ) : (
      <div class="flex flex-col gap-3" data-testid="recent-decisions">
        {recentlyModerated.map((job) => (
          <div class="flex flex-col gap-3 rounded-xl border border-base-300 bg-base-100 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-semibold leading-snug text-base-content">{job.title}</h3>
                <span
                  class:list={[
                    "badge badge-sm",
                    JOB_STATUS_BADGE_CLASS[job.online_status] ?? "badge-neutral",
                  ]}
                >
                  {statusLabel[job.online_status] ?? job.online_status}
                </span>
              </div>
              <p class="text-sm text-base-content/70">
                {job.company} · {job.location}
              </p>
              <p class="text-xs text-base-content/40">
                {t.admin.decidedAt(
                  new Date(job.updatedAt).toLocaleDateString(t.auth.dateLocale, {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })
                )}
              </p>
            </div>
            <a class="btn btn-outline btn-sm" href={`/admin/jobs/${job.slug}/edit`}>
              {t.admin.editJob}
            </a>
          </div>
        ))}
      </div>
    )
  }
</PageLayout>
