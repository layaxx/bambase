---
import { actions, isInputError } from "astro:actions"
import PageLayout from "@/layouts/PageLayout.astro"
import { fetchStudentGroupForAdmin } from "@/utils/api"
import { canManageStudentGroups } from "@/utils/authz"
import { useTranslations } from "@/i18n/translations"
import IconArrowLeft from "@/components/icons/IconArrowLeft.astro"
import StudentGroupForm from "@/components/student-groups/StudentGroupForm.astro"

const t = useTranslations(Astro.locals.locale)

const user = Astro.locals.user
if (!user) {
  return Astro.redirect(`/login?redirect=/admin/student-groups/${Astro.params.slug}/edit`)
}
if (!(await canManageStudentGroups(user.role))) return Astro.redirect("/")

const { slug } = Astro.params
const { data: group } = slug ? await fetchStudentGroupForAdmin(slug) : { data: null }
if (!group) return Astro.redirect("/admin/student-groups")

const result = Astro.getActionResult(actions.studentGroups.update)
if (result?.data) return Astro.redirect("/admin/student-groups")

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const generalError = result?.error && !isInputError(result.error) ? result.error.message : null
---

<PageLayout title={t.studentGroups.editTitle}>
  <div class="mb-6">
    <a class="btn btn-ghost btn-sm gap-1 pl-0" href="/admin/student-groups">
      <IconArrowLeft class="h-4 w-4" />
      {t.admin.studentGroupsTitle}
    </a>
  </div>

  <section class="mb-8">
    <h1 class="mb-1 text-3xl font-bold tracking-tight sm:text-4xl">{t.studentGroups.editTitle}</h1>
  </section>

  {
    generalError && (
      <div class="alert alert-error mb-6" role="alert">
        <span>{generalError}</span>
      </div>
    )
  }

  <StudentGroupForm
    action={actions.studentGroups.update}
    cancelHref="/admin/student-groups"
    id={group.id}
    initialValues={{
      name: group.name,
      description: group.description,
      website: group.website ?? "",
      instagram: group.instagram ?? "",
      facebook: group.facebook ?? "",
      email: group.email ?? "",
    }}
    inputErrors={inputErrors}
    submitLabel={t.studentGroups.updateStudentGroup}
  />
</PageLayout>
