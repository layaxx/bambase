# Copy to .env for local development.
# Deployment configuration lives in the separate bambase-deploy repository.

# Local database — matches docker-compose.dev.yml
DATABASE_URL="postgresql://backend:backend@localhost:5432/backend?schema=public"

# Public URL of this instance; used in email confirmation redirect links
FRONTEND_URL=http://localhost:4321

BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL="http://localhost:4321"

# Cookie from Feki.de to fetch job offers for migration; omit to disable migration
JOB_OFFER_MIGRATION_COOKIE="xxx=yyyy"

# Mailgun — leave unset to log emails to the console instead of sending them
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Base URL for the Studierendenwerk Würzburg Mensa API; omit to use the default
SWERK_API_BASE=

# Run the Mensa / UniVis event importers once at startup
LOAD_MENSA_ON_STARTUP=false
LOAD_EVENTS_ON_STARTUP=false
